# ===================================================
# DJED Social Platform - Environment Configuration Template
# All secrets must be populated in server-side runtime environments only.
# Never commit real credentials to version control.
# ===================================================

# Server Runtime & Environments
NODE_ENV="development"
APP_ENV="development"
PORT=3000

# Origins & Networking
APP_ORIGIN="http://localhost:3000"
API_ORIGIN="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://djed.network"
COOKIE_DOMAIN="localhost"

# Neon PostgreSQL Database Connection (Separate URL per environment)
# Example format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://djed_user:password_placeholder@ep-sample.eu-central-1.aws.neon.tech/djed_dev?sslmode=require"

# Cryptographic Keys & Sessions
SESSION_SECRET="generate_32_byte_cryptographic_secret_here"
CSRF_SECRET="generate_32_byte_csrf_secret_here"

# S3-Compatible Object Storage (Media uploads: images, videos)
OBJECT_STORAGE_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
OBJECT_STORAGE_REGION="eu-central-1"
OBJECT_STORAGE_BUCKET="djed-media-dev"
OBJECT_STORAGE_ACCESS_KEY_ID="placeholder_access_key_id"
OBJECT_STORAGE_SECRET_ACCESS_KEY="placeholder_secret_access_key"

# Observability & Logging
LOG_LEVEL="info"
